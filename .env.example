# ==========================================
# NEXA AI Environment Configuration
# ==========================================

# --- AI API Configuration ---
# GEMINI_API_KEY: Required for Gemini AI API calls (Chat, Reasoning, Deep Research, Coding, Data Analysis, Multimodal Vision, and Image Studio).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- Host / Application URL ---
# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- Optional External Search / Grounding ---
# Enabled automatically via Google Search Grounding when GEMINI_API_KEY is present.
SEARCH_PROVIDER="google_grounding"

# --- Optional Payment Provider (Stripe) Configuration ---
# Configure to activate live Pro and Enterprise plan checkout flows.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Optional Authentication / Database Configuration ---
# When deployed to enterprise cloud infrastructure, optionally configure external DB URI.
DATABASE_URL=""
JWT_SECRET=""

